  rw [GroundTheory.Arith.Abelian.Jacobian.ringKrullDim_eq_trdeg F, htz, Fintype.card_option,
    show e + i - 1 + (Fintype.card K + 1) = e + Fintype.card K + i by omega]
  simp

end

