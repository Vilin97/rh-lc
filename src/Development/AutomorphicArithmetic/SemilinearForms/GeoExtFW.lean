  rcases B' with ⟨P'⟩
  change P' = B.toPre at hP
  subst hP
  exact ⟨(by with_unfolding_all exact (m :)), (by with_unfolding_all exact ((HEq.refl m) :)), fun j => (by with_unfolding_all exact ((HEq.refl (m j)) :))⟩

