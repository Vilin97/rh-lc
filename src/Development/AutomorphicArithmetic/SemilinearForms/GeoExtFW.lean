          CrdOver ι (z.geo.fw.e i φ : (z.R.FW i).WK).1 (fw'.e i' φ' : (R'.FW i').WK).1) := by
  intro B B' f f' T T' w w' hPre Z hX Wt z Z' hX' Wt' core' alg' halg hcore hlaws Xg tr R' hRS hf hL' ι hι
