  have hE : VK p.fw i = p.T.cuspA ((i : ℕ) + 1) (wtA (p.κ i)) (p.κ i).n := GlobalTheory.AllWt.cuspW_wtZ _ _
  let g : VK p.fw i := ⟨f.1, hE.symm ▸ f.2⟩
  obtain ⟨h, hg⟩ := hι g
  have e1 : ι g = b k := by
    rw [hg]
    have : (⟨(g : p.T.R ((i : ℕ) + 1)), h⟩ : p.T.cuspA ((i : ℕ) + 1) (wtA (p.κ i)) (p.κ i).n) = f := Subtype.ext rfl
