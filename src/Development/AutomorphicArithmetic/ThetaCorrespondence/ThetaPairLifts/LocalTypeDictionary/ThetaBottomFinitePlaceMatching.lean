  refine ⟨a₁, fun ε CF hCF => ?_⟩
  obtain ⟨C₁, x₁, h₁⟩ := h₁ ε CF hCF
  exact ⟨C₁, x₁, fun C hC D large₂ he hx r T Lc μ hLc G => H G μ C _ _ (h₁ C hC D large₂ he hx r T Lc μ hLc G)⟩

