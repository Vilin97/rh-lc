      simp only [_root_.GlobalTheory.SplitLagrF.prof_heis_lift_k hB hS hT hξ hσξ hν h𝓕 hf])
  rw [← prof_zero (σ := σ) (JS := JS) (JT := JT) (ξ₀ := ξ₀) (ψ := B.ψ)]
  exact congrFun hφ 0
