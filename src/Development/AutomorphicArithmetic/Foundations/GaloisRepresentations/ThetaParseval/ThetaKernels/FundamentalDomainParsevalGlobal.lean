theorem commF_eventually_k (hB : _root_.UpperTheory.TP.W.GoodK σ B) {e : AEF F E} (he : IsSplitIdemF σ e) (g : WOF F E nS nT) :
    ∀ᶠ y : conjHalf σ e nS nT in nhds 0, commF σ JS JT ξ₀ B.ψ g y = 1 := by
