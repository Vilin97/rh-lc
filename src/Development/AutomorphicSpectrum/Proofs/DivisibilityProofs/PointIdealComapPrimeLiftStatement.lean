theorem _root_.GlobalTheory.T.point_ideal_comap_prime_lift : ∀ (K : Type) [Fintype K] [DecidableEq K] (ι : K → Type) [∀ k, Fintype (ι k)] (Ω : Type) [Field Ω] (y : (Σ k, ι k) → Ω) (A : Type) [CommRing A] [Algebra A Ω], HasConstants ℤ A y → (pointIdeal A y).comap (MvPolynomial.map (Int.castRingHom A)) = mCoordIdeal y ∧ (∀ W : Ideal (ReciprocityTheory.ChartRestriction.G.Geo.MRingOver ℤ ι), W.IsPrime → IsRelevant W → mCoordIdeal y ≤ W → ∃! W' : Ideal (ReciprocityTheory.ChartRestriction.G.Geo.MRingOver A ι), W'.IsPrime ∧ pointIdeal A y ≤ W' ∧ W'.comap (MvPolynomial.map (Int.castRingHom A)) = W) ∧ ∀ (f : ReciprocityTheory.ChartRestriction.G.Geo.MRingOver ℤ ι) (W' : Ideal (ReciprocityTheory.ChartRestriction.G.Geo.MRingOver A ι)), W'.IsPrime → IsRelevant W' → pointIdeal A y ≤ W' → ((ReciprocityTheory.ChartRestriction.G.Geo.divCycle (pointIdeal A y) (MvPolynomial.map (Int.castRingHom A) f)) W' : ℤ) = ((ReciprocityTheory.ChartRestriction.G.Geo.divCycle (mCoordIdeal y) f) (W'.comap (MvPolynomial.map (Int.castRingHom A))) : ℤ) := by
  first | exact @GlobalTheory.CompanionTheory.Ar.Num.pl_corr | exact GlobalTheory.CompanionTheory.Ar.Num.pl_corr | (intros; apply GlobalTheory.CompanionTheory.Ar.Num.pl_corr <;> assumption)
