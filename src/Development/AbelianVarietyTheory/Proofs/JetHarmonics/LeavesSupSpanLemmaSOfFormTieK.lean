    apply span_spanK_eq_top
    apply top_unique
    rw [← hSp]
    apply Submodule.span_le.2
    intro f hf
    let a : 𝓞 B.KO := (scalOfP B hinj EX p ka wL wF T).sK
    let b : 𝓞 B.KO := ((D.host.g 0 * D.host.g 1 : ℕ) : 𝓞 B.KO) ^ (D.R.f * D.R.r * ka.n)
