  first | exact @GlobalTheory.exists_class_group_mk0_eq_mul_pow | exact GlobalTheory.exists_class_group_mk0_eq_mul_pow | (intros; apply GlobalTheory.exists_class_group_mk0_eq_mul_pow <;> assumption)
