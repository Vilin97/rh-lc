  · obtain ⟨q₀, hy, -, heq⟩ := I.lin n hn x a
    obtain ⟨c, hc, -⟩ := (hQ n).1 q₀
    obtain ⟨z, hz, -⟩ := ((hQ n).2.2 _ _ _ _ hc (hq n (x • a))).1 heq
    exact ⟨ν.eX z, by rw [hz, map_add (f := _), map_nsmul, hc.1, hy, (hq n a).1]⟩

