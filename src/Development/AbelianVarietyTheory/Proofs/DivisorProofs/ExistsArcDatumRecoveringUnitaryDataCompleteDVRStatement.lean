    Units.map (algebraMap (FractionRing T.V) F).toMonoidHom (rF D hϖ l.M' y x)
  have hs : IsRootForm (𝓞 E) l.M' (tF D hϖ) s :=
    ⟨hR.1.map _, fun y x => by
