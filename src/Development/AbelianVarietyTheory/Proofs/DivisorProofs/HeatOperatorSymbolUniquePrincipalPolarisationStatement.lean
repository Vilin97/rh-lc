    have h2 : ∀ (a : R) (τ : SecM (𝟙 Y) L k), sval (constFn p ⊤ a • τ) (t ≫ x) z J =
        germConstHom ((t ≫ x) ≫ p) z a * sval τ (t ≫ x) z J := fun a τ =>
      (gs_mul _ z _ hm _ _).trans (congrArg₂ (· * ·)
