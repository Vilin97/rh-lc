  refine ⟨r * r', constFn p ⊤ r' • σ - constFn p ⊤ r • σ', φ r' * ω - φ r * ω', mul_ne_zero hr hr', ?_, ?_⟩
  · intro Z t z J hJ
    have e : ∀ a : R, ((spMap φ).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom a)) =
        (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (φ a) := by
      intro a
