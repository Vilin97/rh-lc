  have hlat := GlobalTheory.T.mem_tensorLatticeAtPlace_iff_frame_coordinates_integral F E v a (a + a') G.V G.W L ι hinj him hmul hint PV PW hPV hPW
  have e1 : ∀ M : Matrix (Fin a) (Fin (a + a')) L,
