  have ha1t (g : ↥H) (t : ↥T.L.T) : a g (k t) = k (T.actT g.1 t) :=
    GlobalTheory.HerrClassMaps.TWact_one_tmul (r (g.1 : GQ l)) T g.1 t
  have hLiftMul (g g' : ↥H) : liftC (g * g') = liftC g + T.actT g.1 (liftC g') :=
