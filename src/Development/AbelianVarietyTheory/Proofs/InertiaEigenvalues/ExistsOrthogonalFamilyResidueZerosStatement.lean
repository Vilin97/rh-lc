  have hR1 : R < 1 := (Finset.sup'_lt_iff _).2 fun j _ => (hρ j).2
  refine ⟨fun j k => y k j, j0, ρ j0, R, (hρ j0).1.le, (hρ j0).2, hR1,
    fun a k => (hyS k a).trans (hρR a), fun k => hyS k j0, ?_, ?_⟩
  · show ρ j0 ^ l ^ h < ‖sh (y 0 j0)‖
