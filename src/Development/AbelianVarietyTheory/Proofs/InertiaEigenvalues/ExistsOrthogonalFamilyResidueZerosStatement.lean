    have := congrFun hx0z j0
    rw [this]; exact hj0
  · intro i
    refine GlobalTheory.T.sum_mul_untiltFrobeniusDoubleSeries_eq_zero l h μ i y R (by omega) hR1 (fun k j => (hyS k j).trans (hρR j)) ?_
    have := hysum i
    simpa [η, hmu] using this

end GlobalTheory.CoreOrth

